# Copia este archivo a .env y ajusta los valores.
# .env está en .gitignore: las credenciales NO se suben al repositorio.

APP_NAME="simpleMVC"
APP_ENV=dev
# En producción: APP_ENV=prod y APP_DEBUG=false (oculta trazas y muestra página de error genérica).
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

# Si instalas el proyecto en un subdirectorio (ej. http://localhost/rutas_amigables/)
# déjalos vacíos: tanto la base de las rutas como la de los assets se autodetectan
# comparando DOCUMENT_ROOT con la ubicación física de public/index.php.
# APP_BASE_PATH: prefijo que hay que quitar de la URL para leer las rutas.
# APP_PUBLIC_PREFIX: prefijo bajo el que están los archivos públicos (assets).
APP_BASE_PATH=
APP_PUBLIC_PREFIX=

# ---------------------------------------------------------------------------
# Base de datos
# DB_DRIVER=sqlite  -> cero configuración, ideal para probar la demo.
# DB_DRIVER=mysql   -> requiere servidor MySQL/MariaDB.
# ---------------------------------------------------------------------------
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/db/app.sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mvc
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# Sesión y logs
# ---------------------------------------------------------------------------
SESSION_NAME=simplemvc_session
SESSION_LIFETIME=7200
LOG_PATH=storage/logs/app.log
LOG_LEVEL=debug
